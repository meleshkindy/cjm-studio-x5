CJM_DATABASE_URL=postgres://cjm_studio:cjm_studio@localhost:5432/cjm_studio?sslmode=disable
# Вместо строки выше можно указать путь к локальному файлу с ней:
# CJM_DATABASE_URL_FILE=C:\Users\user\AppData\Roaming\CJM Studio\postgres-url.txt
# Укажите только при первом запуске на пустой базе PostgreSQL.
CJM_SQLITE_IMPORT=C:\path\to\cjm-studio-backup.sqlite

# Keycloak/OIDC. Эти параметры читаются исполняемым файлом при запуске.
CJM_AUTH_ENABLED=true
VITE_KEYCLOAK_URL=https://key-stage.x5.ru/auth
VITE_KEYCLOAK_REALM=X5
VITE_KEYCLOAK_CLIENT_ID=idp_axiosdc92b_O7k
VITE_RESTORE_PASSWORD_URL=https://sts2.x5.ru/adfs/portal/updatepass

# Для многопользовательского сервера. Публикуйте приложение только через HTTPS reverse proxy.
CJM_LISTEN_ADDRESS=0.0.0.0
